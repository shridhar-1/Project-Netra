# ---------------------------------------------------------------
# .gitignore for "Project Netra (Cyber Eye)"
# Save this file at the project ROOT, named exactly: .gitignore
#   C:\Users\SHRIDHAR\Documents\Project Netra (Cyber Eye)\.gitignore
# Be careful: Windows Explorer hides extensions. If the file ends up
# named ".gitignore.txt" git will silently ignore it. Verify in
# VS Code's Explorer — the file should read ".gitignore".
# ---------------------------------------------------------------

# ---- Dependencies (never commit; reinstall with npm install) ----
node_modules/
**/node_modules/
.pnp
.pnp.*

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# ---- Build output / compiled ----
dist/
build/
out/
.output/
.next/
target/
*.class
*.tsbuildinfo

# ---- Secrets: never commit these ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*secret*
*credentials*
# (if a hit above looks like a false positive, e.g. a file named
#  "secret_santa.py", add a negation line:  !secret_santa.py)

# ---- Zoho Catalyst ----
# Per-developer project binding. Regenerated by `catalyst login`.
# Harmless to commit, but it causes merge conflicts between machines.
.catalystrc

# ---- SQLite temp sidecar files ----
# The .db file itself IS committed (it's synthetic data the app needs).
# These three are transient and can corrupt a clone if committed.
*.db-wal
*.db-shm
*.db-journal

# ---- OS junk ----
.DS_Store
._*
Thumbs.db
desktop.ini

# ---- Editors ----
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ---- Logs ----
*.log
npm-debug.log*
yarn-error.log*

# ---------------------------------------------------------------
# IF karnataka_police_fir.db is over ~50 MB, uncomment the next line
# and the repo will stay lean. Downside: a fresh clone won't have the
# data, so document it in the README instead.
# karnataka_police_fir.db
# ---------------------------------------------------------------

# ---- Catalyst build output + export archives ----
**/.build/
.build/
**/Import_*.zip
Import_*.zip
